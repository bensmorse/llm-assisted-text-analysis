identify_non_mdy_hm <- function(datetime_vector) {
# Attempt to parse with mdy_hm
parsed <- mdy_hm(datetime_vector, quiet = TRUE)
# Return which observations failed to parse (NA results)
which(is.na(parsed))
}
test <- identify_non_mdy_hm(df$Review_Date)
dim(test)
